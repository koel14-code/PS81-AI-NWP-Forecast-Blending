# =====================================================================
# Environment Configuration for PS81 AI-NWP Forecast Blending System
# Copy this file to .env and adjust values for your local setup
# =====================================================================

# Project Environment (development, testing, production)
ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Paths (Relative to project root or Absolute local paths)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODEL_CHECKPOINT_DIR=./models_checkpoints

# Geographic Bounding Box for Initial MVP (e.g., India Regional Coordinates: MinLat, MaxLat, MinLon, MaxLon)
REGION_MIN_LAT=6.0
REGION_MAX_LAT=38.0
REGION_MIN_LON=68.0
REGION_MAX_LON=98.0

# Target Parameter for MVP
TARGET_PARAMETER=rainfall

# Default Forecast Lead Time Window (in hours, e.g., 24, 48, 72, 120, 240)
DEFAULT_LEAD_TIMES=24,48,72,120
