#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════
#  SkyBlend AI — One-Command Startup Script (macOS / Linux)
#  Usage:  ./nwp
#  Starts the FastAPI backend + React/Vite frontend in parallel.
#  Auto-installs Python & Node dependencies if missing.
# ══════════════════════════════════════════════════════════════════════
set -euo pipefail

# ── Colours ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Resolve project root (where this script lives) ──────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ── PIDs for cleanup ────────────────────────────────────────────────
BACKEND_PID=""
FRONTEND_PID=""

cleanup() {
    echo ""
    echo -e "${YELLOW}⏹  Shutting down SkyBlend AI...${RESET}"
    [[ -n "$BACKEND_PID" ]] && kill "$BACKEND_PID" 2>/dev/null && echo -e "${DIM}   Stopped backend  (PID $BACKEND_PID)${RESET}"
    [[ -n "$FRONTEND_PID" ]] && kill "$FRONTEND_PID" 2>/dev/null && echo -e "${DIM}   Stopped frontend (PID $FRONTEND_PID)${RESET}"
    # Kill any child processes in our process group
    kill 0 2>/dev/null || true
    echo -e "${GREEN}✔  All services stopped.${RESET}"
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

banner() {
    echo ""
    echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${CYAN}${BOLD}║         ☁  SkyBlend AI — NWP Forecast Blending System       ║${RESET}"
    echo -e "${CYAN}${BOLD}║                   SIH Problem Statement PS81                 ║${RESET}"
    echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════╝${RESET}"
    echo ""
}

info()    { echo -e "${CYAN}ℹ  $1${RESET}"; }
success() { echo -e "${GREEN}✔  $1${RESET}"; }
warn()    { echo -e "${YELLOW}⚠  $1${RESET}"; }
fail()    { echo -e "${RED}✖  $1${RESET}"; exit 1; }
step()    { echo -e "\n${BOLD}── $1 ──${RESET}"; }

# ══════════════════════════════════════════════════════════════════════
banner

# ── 1. Check Python ──────────────────────────────────────────────────
step "Checking Python"

PYTHON_CMD=""
for cmd in python3 python; do
    if command -v "$cmd" &>/dev/null; then
        PY_VERSION=$("$cmd" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+')
        PY_MAJOR=$(echo "$PY_VERSION" | cut -d. -f1)
        PY_MINOR=$(echo "$PY_VERSION" | cut -d. -f2)
        if [[ "$PY_MAJOR" -ge 3 ]] && [[ "$PY_MINOR" -ge 10 ]]; then
            PYTHON_CMD="$cmd"
            break
        fi
    fi
done

if [[ -z "$PYTHON_CMD" ]]; then
    fail "Python 3.10+ is required but not found.\n   Install from https://www.python.org/downloads/"
fi
success "Found $($PYTHON_CMD --version) at $(which $PYTHON_CMD)"

# ── 2. Check Node.js ────────────────────────────────────────────────
step "Checking Node.js"

if ! command -v node &>/dev/null; then
    fail "Node.js is required but not found.\n   Install from https://nodejs.org/ (v18+ recommended)"
fi
NODE_VERSION=$(node --version)
success "Found Node.js $NODE_VERSION at $(which node)"

if ! command -v npm &>/dev/null; then
    fail "npm is required but not found. It should come with Node.js."
fi
success "Found npm $(npm --version)"

# ── 3. Python virtual environment ───────────────────────────────────
step "Setting up Python environment"

VENV_DIR="$SCRIPT_DIR/venv"
# Also check .venv if venv doesn't exist
if [[ ! -d "$VENV_DIR" ]]; then
    VENV_DIR="$SCRIPT_DIR/.venv"
fi

if [[ ! -d "$VENV_DIR" ]]; then
    VENV_DIR="$SCRIPT_DIR/venv"
    info "Creating virtual environment at $VENV_DIR ..."
    "$PYTHON_CMD" -m venv "$VENV_DIR"
    success "Virtual environment created."
else
    success "Virtual environment found at $VENV_DIR"
fi

# Activate
source "$VENV_DIR/bin/activate"
success "Virtual environment activated."

# ── 4. Install Python dependencies ──────────────────────────────────
step "Checking Python dependencies"

# Quick check: try importing the critical packages
DEPS_OK=true
"$VENV_DIR/bin/python" -c "import fastapi, uvicorn, pandas, sklearn, joblib" 2>/dev/null || DEPS_OK=false

if [[ "$DEPS_OK" == false ]]; then
    warn "Some Python dependencies are missing. Installing..."
    if [[ -f "$SCRIPT_DIR/requirements.runtime.txt" ]]; then
        pip install --upgrade pip --quiet 2>/dev/null
        pip install -r "$SCRIPT_DIR/requirements.runtime.txt" --quiet
    elif [[ -f "$SCRIPT_DIR/requirements.txt" ]]; then
        pip install --upgrade pip --quiet 2>/dev/null
        pip install -r "$SCRIPT_DIR/requirements.txt" --quiet
    else
        fail "No requirements file found."
    fi
    success "Python dependencies installed."
else
    success "All Python dependencies are installed."
fi

# ── 5. Install frontend dependencies ────────────────────────────────
step "Checking frontend dependencies"

FRONTEND_DIR="$SCRIPT_DIR/frontend"

if [[ ! -d "$FRONTEND_DIR" ]]; then
    fail "Frontend directory not found at $FRONTEND_DIR"
fi

if [[ ! -d "$FRONTEND_DIR/node_modules" ]]; then
    warn "Node modules not found. Installing frontend dependencies..."
    (cd "$FRONTEND_DIR" && npm install --silent)
    success "Frontend dependencies installed."
else
    success "Frontend dependencies are installed."
fi

# ── 6. Pre-flight: check critical data files ────────────────────────
step "Pre-flight checks"

MISSING_DATA=false
DATA_DIR="$SCRIPT_DIR/data/processed"

# Check for at least one of the key data files
if [[ -f "$DATA_DIR/multilocation_rainfall_ml_features_2023_06_to_2024_05.csv" ]]; then
    success "Rainfall features dataset found."
else
    warn "Rainfall features dataset not found — precipitation endpoints may return errors."
    MISSING_DATA=true
fi

if [[ -f "$DATA_DIR/multilocation_temperature_forecast_inputs.csv" ]]; then
    success "Temperature inputs dataset found."
else
    warn "Temperature inputs not found — temperature endpoints may return errors."
    MISSING_DATA=true
fi

if [[ -f "$DATA_DIR/multilocation_wind_forecast_inputs.csv" ]]; then
    success "Wind inputs dataset found."
else
    warn "Wind inputs not found — wind endpoints may return errors."
    MISSING_DATA=true
fi

# Check model artifacts
MODEL_DIR="$SCRIPT_DIR/models/expanded_full_year"
if [[ -f "$MODEL_DIR/adaptive_blender_ECMWF_IFS.joblib" ]]; then
    success "Phase 6 rainfall model artifacts found."
else
    warn "Phase 6 model artifacts (.joblib) not found — ML inference unavailable."
    MISSING_DATA=true
fi

if [[ "$MISSING_DATA" == true ]]; then
    echo ""
    warn "Some data/model files are missing (they are gitignored)."
    info "The API will start but some endpoints may return 500 errors."
    info "Run the training pipeline to regenerate: python scripts/train_and_evaluate_expanded_model.py"
    echo ""
fi

# ── 7. Start Backend ────────────────────────────────────────────────
step "Starting FastAPI Backend"

BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"

# Check if port is already in use
if lsof -i ":$BACKEND_PORT" &>/dev/null 2>&1; then
    warn "Port $BACKEND_PORT is already in use. Attempting to use port 8001..."
    BACKEND_PORT="8001"
    if lsof -i ":$BACKEND_PORT" &>/dev/null 2>&1; then
        fail "Ports 8000 and 8001 are both in use. Free one and retry."
    fi
fi

info "Starting uvicorn on http://$BACKEND_HOST:$BACKEND_PORT ..."
PYTHONPATH="$SCRIPT_DIR" "$VENV_DIR/bin/python" -m uvicorn src.api.main:app \
    --host "$BACKEND_HOST" \
    --port "$BACKEND_PORT" \
    --reload \
    --log-level info &
BACKEND_PID=$!
sleep 2

# Quick health check
if kill -0 "$BACKEND_PID" 2>/dev/null; then
    success "Backend running (PID $BACKEND_PID) → http://$BACKEND_HOST:$BACKEND_PORT"
    info "API docs → http://$BACKEND_HOST:$BACKEND_PORT/docs"
else
    fail "Backend failed to start. Check logs above."
fi

# ── 8. Start Frontend ───────────────────────────────────────────────
step "Starting React Frontend"

FRONTEND_PORT="5173"

# Check if port is already in use
if lsof -i ":$FRONTEND_PORT" &>/dev/null 2>&1; then
    warn "Port $FRONTEND_PORT is already in use. Attempting to use port 5174..."
    FRONTEND_PORT="5174"
fi

info "Starting Vite dev server on http://localhost:$FRONTEND_PORT ..."
(cd "$FRONTEND_DIR" && VITE_API_BASE_URL="http://$BACKEND_HOST:$BACKEND_PORT" npx vite --port "$FRONTEND_PORT" --host) &
FRONTEND_PID=$!
sleep 3

if kill -0 "$FRONTEND_PID" 2>/dev/null; then
    success "Frontend running (PID $FRONTEND_PID) → http://localhost:$FRONTEND_PORT"
else
    fail "Frontend failed to start. Check logs above."
fi

# ── 9. Ready ─────────────────────────────────────────────────────────
echo ""
echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${GREEN}${BOLD}║              ✔  SkyBlend AI is up and running!               ║${RESET}"
echo -e "${GREEN}${BOLD}╠══════════════════════════════════════════════════════════════╣${RESET}"
echo -e "${GREEN}${BOLD}║                                                              ║${RESET}"
echo -e "${GREEN}${BOLD}║   🌐 Frontend:  http://localhost:${FRONTEND_PORT}                        ║${RESET}"
echo -e "${GREEN}${BOLD}║   ⚡ Backend:   http://${BACKEND_HOST}:${BACKEND_PORT}                   ║${RESET}"
echo -e "${GREEN}${BOLD}║   📄 API Docs:  http://${BACKEND_HOST}:${BACKEND_PORT}/docs              ║${RESET}"
echo -e "${GREEN}${BOLD}║                                                              ║${RESET}"
echo -e "${GREEN}${BOLD}║   Press Ctrl+C to stop all services.                         ║${RESET}"
echo -e "${GREEN}${BOLD}║                                                              ║${RESET}"
echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════════════════════╝${RESET}"
echo ""

# Wait for any child to exit
wait
